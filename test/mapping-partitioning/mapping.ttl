@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex: <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <http://example.com/base/> .

<StudentMap> a rml:TriplesMap ;
    rml:logicalSource [
        rml:source "test/mapping-partitioning/student.csv" ;
        rml:referenceFormulation rml:CSV
    ] ;
    rml:subjectMap [
        rml:template "http://example.com/student/{ID}" ;
        rml:class foaf:Person
    ] ;
    rml:predicateObjectMap [
        rml:predicate foaf:name ;
        rml:objectMap [ rml:reference "Name" ]
    ] ;
    rml:predicateObjectMap [
        rml:predicate foaf:age ;
        rml:objectMap [ rml:reference "Age" ; rml:datatype xsd:integer ]
    ] ;
    rml:predicateObjectMap [
        rml:predicate ex:plays ;
        rml:objectMap [
            rml:parentTriplesMap <SportMap> ;
            rml:joinCondition [ rml:child "Sport" ; rml:parent "ID" ]
        ]
    ] .

<SportMap> a rml:TriplesMap ;
    rml:logicalSource [
        rml:source "test/mapping-partitioning/sport.csv" ;
        rml:referenceFormulation rml:CSV
    ] ;
    rml:subjectMap [
        rml:template "http://example.com/sport/{ID}" ;
        rml:class ex:Sport
    ] ;
    rml:predicateObjectMap [
        rml:predicate ex:sportName ;
        rml:objectMap [ rml:reference "Name" ]
    ] .
