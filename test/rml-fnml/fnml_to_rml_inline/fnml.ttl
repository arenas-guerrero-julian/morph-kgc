# Legacy FNML (fnml:functionValue) with the calling term maps written inline,
# i.e. as blank nodes rather than as named resources.

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix ex:   <http://example.com#> .

<http://mapping.example.com/map_cars_000> a rr:TriplesMap ;
  rml:logicalSource [
    a rml:LogicalSource ;
    rml:source "cars.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [ rr:template "http://example.com#car_{ID}" ] ;

  # Single function call issued by an inline object map.
  rr:predicateObjectMap [
    rr:predicate ex:upperName ;
    rr:objectMap [
      a fnml:FunctionTermMap ;
      rr:termType rr:Literal ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:object grel:toUpperCase
        ] ;
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter ;
          rr:objectMap [ rml:reference "Name" ]
        ]
      ]
    ]
  ] ;

  # Nested function call: the inner call is issued by an inline object map too.
  rr:predicateObjectMap [
    rr:predicate ex:brand ;
    rr:objectMap [
      a fnml:FunctionTermMap ;
      rr:termType rr:Literal ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:object grel:array_get
        ] ;
        rr:predicateObjectMap [
          rr:predicate grel:p_array_a ;
          rr:objectMap [
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:object grel:string_split
              ] ;
              rr:predicateObjectMap [
                rr:predicate grel:valueParameter ;
                rr:objectMap [ rml:reference "Model" ]
              ] ;
              rr:predicateObjectMap [
                rr:predicate grel:p_string_sep ;
                rr:objectMap [ rr:constant " " ]
              ]
            ]
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate grel:param_int_i_from ;
          rr:objectMap [ rr:constant "0" ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate grel:param_int_i_opt_to ;
          rr:objectMap [ rr:constant "1" ]
        ]
      ]
    ]
  ] .
